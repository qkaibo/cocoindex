# Optional: enable LLM-powered entity/concept extraction
# When set, each code file and wiki page is sent to the LLM for structured extraction.
# When unset, the pipeline still works perfectly — semantic vector search only.
#
# LLM_MODEL=openai/gpt-4o-mini
# LLM_MODEL=gemini/gemini-2.5-flash
# LLM_MODEL=ollama/llama3.2

# LiteLLM provider keys (set the one matching your model above)
OPENAI_API_KEY=
# GEMINI_API_KEY=
