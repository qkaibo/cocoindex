examples/rust/pdf_to_markdown/out/
# Downloaded embedding model cache (fastembed) — e.g. code-embedding example
.fastembed_cache/

# Byte-compiled / optimized / DLL files
__pycache__/
.pytest_cache/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.venv*/
dist/
uv.lock

.DS_Store

*.egg-info/

/.vscode
/*.session.sql

.mypy_cache
.dmypy.json

# LMDB files
*.mdb

